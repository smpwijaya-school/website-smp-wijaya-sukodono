---
import { spmb, pengaturan } from '../utils/data';

interface Props {
  activeNav?: string;
}

const { activeNav = 'home' } = Astro.props;

const shouldShowPopup = spmb.aktif && activeNav !== 'spmb' && activeNav !== 'ppdb';

const posterFoto = spmb.popup?.poster?.trim() || '';
const hasPoster = Boolean(posterFoto);
const fallbackFoto = spmb.hero?.foto?.trim() || '/images/hero/hero-ppdb.webp';

const ctaTeks = spmb.popup?.cta_teks?.trim() || 'Daftar SPMB Sekarang';
const ctaLink = spmb.popup?.cta_link?.trim() || '/spmb';
const isExternalCta = /^https?:\/\//i.test(ctaLink);

const jadwalPreview = (spmb.jadwal || []).slice(0, 3);
const storageKey = `smp_wijaya_spmb_popup_dismissed_${spmb.tahun_ajaran}`;
---

{shouldShowPopup && (
  <div
    id="spmb-popup-modal"
    data-storage-key={storageKey}
    class="hidden fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4 opacity-0 transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="spmb-popup-title"
  >
    <div
      id="spmb-popup-container"
      class="bg-ocean-950 rounded-2xl max-w-md sm:max-w-lg w-full overflow-hidden shadow-2xl relative transform scale-95 opacity-0 transition-all duration-200 ease-out max-h-[92vh] flex flex-col border border-white/15"
    >
      <h2 id="spmb-popup-title" class="sr-only">
        Poster Pengumuman SPMB {spmb.tahun_ajaran} {pengaturan.nama_sekolah}
      </h2>

      <!-- Floating Close Button -->
      <button
        id="spmb-popup-close-x"
        type="button"
        aria-label="Tutup poster SPMB"
        class="absolute top-3 right-3 z-30 w-10 h-10 rounded-full bg-ocean-950/80 hover:bg-ocean-950 text-white border border-white/25 backdrop-blur-md shadow-lg flex items-center justify-center transition hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-candiGold-400"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      {hasPoster ? (
        <a
          href={ctaLink}
          target={isExternalCta ? '_blank' : undefined}
          rel={isExternalCta ? 'noopener noreferrer' : undefined}
          class="spmb-popup-cta-trigger block flex-1 min-h-0 bg-ocean-950 overflow-hidden focus:outline-none"
        >
          <img
            src={posterFoto}
            alt={`Poster Penerimaan Murid Baru (SPMB) ${spmb.tahun_ajaran} ${pengaturan.nama_sekolah}`}
            class="block w-full h-auto max-h-[75vh] object-contain mx-auto"
            loading="eager"
            decoding="async"
          />
        </a>
      ) : (
        <div class="relative flex-1 min-h-0 overflow-y-auto text-white flex flex-col justify-between p-6 sm:p-7">
          <img
            src={fallbackFoto}
            alt=""
            class="absolute inset-0 w-full h-full object-cover object-center opacity-30"
            loading="eager"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-ocean-950/90 via-ocean-950/80 to-ocean-950/95"></div>

          <div class="relative z-10 space-y-4 pr-8">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-white/10 p-1.5 border border-white/15 shrink-0">
                <svg viewBox="0 0 200 200" class="w-full h-full" aria-hidden="true">
                  <use href="#logo-smp-wijaya"></use>
                </svg>
              </div>
              <div>
                <div class="text-xs font-mono font-bold uppercase tracking-wider text-wijayaCyan-300">
                  {pengaturan.nama_sekolah}
                </div>
                <div class="text-[11px] font-mono text-sky-200/80">
                  NPSN {pengaturan.npsn} &bull; {pengaturan.akreditasi}
                </div>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 pt-1">
              <span class="px-3 py-1 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-xs font-extrabold uppercase tracking-wide shadow">
                SPMB DIBUKA
              </span>
              <span class="px-3 py-1 rounded-full bg-white/15 border border-white/20 text-sky-100 font-mono text-xs font-semibold">
                TA {spmb.tahun_ajaran}
              </span>
            </div>

            <div class="text-2xl sm:text-3xl font-extrabold leading-tight tracking-tight text-white">
              {spmb.hero?.judul || `Penerimaan Murid Baru ${spmb.tahun_ajaran}`}
            </div>

            <p class="text-sm text-sky-100/90 leading-relaxed">
              {spmb.banner?.teks || spmb.hero?.deskripsi}
            </p>
          </div>

          {jadwalPreview.length > 0 && (
            <div class="relative z-10 mt-6 space-y-2">
              {jadwalPreview.map((item) => (
                <div class="px-3.5 py-2.5 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 flex items-center justify-between gap-2 text-xs">
                  <span class="font-semibold text-white truncate">{item.gelombang}</span>
                  <span class="font-mono text-candiGold-400 font-bold shrink-0">{item.waktu}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      <!-- Bottom Full-Width CTA Bar -->
      <div class="p-3.5 sm:p-4 bg-white border-t border-slate-200 shrink-0">
        <a
          id="spmb-popup-cta"
          href={ctaLink}
          target={isExternalCta ? '_blank' : undefined}
          rel={isExternalCta ? 'noopener noreferrer' : undefined}
          class="spmb-popup-cta-trigger w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 text-sm sm:text-base font-extrabold shadow-md transition active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-cerulean-600 focus:ring-offset-2"
        >
          <span>{ctaTeks}</span>
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    (function initSpmbPopupModal() {
      const popup = document.getElementById('spmb-popup-modal');
      const container = document.getElementById('spmb-popup-container');
      const closeXBtn = document.getElementById('spmb-popup-close-x');
      const ctaLink = document.getElementById('spmb-popup-cta');
      const ctaTriggers = popup?.querySelectorAll('.spmb-popup-cta-trigger');
      if (!popup || !container) return;

      const storageKey = popup.dataset.storageKey || 'smp_wijaya_spmb_popup_dismissed';
      let lastFocused = null;

      function isDismissed() {
        try {
          return window.sessionStorage.getItem(storageKey) === '1';
        } catch {
          return false;
        }
      }

      function markDismissed() {
        try {
          window.sessionStorage.setItem(storageKey, '1');
        } catch {
          // Ignore storage errors in strict privacy mode
        }
      }

      function openPopup() {
        lastFocused = document.activeElement;
        document.body.classList.add('overflow-hidden');
        popup.classList.remove('hidden');
        requestAnimationFrame(() => {
          popup.classList.remove('opacity-0');
          container.classList.remove('scale-95', 'opacity-0');
          ctaLink?.focus();
        });
      }

      function closePopup() {
        markDismissed();
        popup.classList.add('opacity-0');
        container.classList.add('scale-95', 'opacity-0');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => {
          popup.classList.add('hidden');
          if (lastFocused && typeof lastFocused.focus === 'function') {
            lastFocused.focus();
          }
        }, 200);
      }

      if (!isDismissed()) {
        const showDelay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 400;
        setTimeout(openPopup, showDelay);
      }

      closeXBtn?.addEventListener('click', closePopup);
      ctaTriggers?.forEach((el) => el.addEventListener('click', markDismissed));

      popup.addEventListener('click', (e) => {
        if (!container.contains(e.target)) closePopup();
      });

      document.addEventListener('keydown', (e) => {
        if (popup.classList.contains('hidden')) return;
        if (e.key === 'Escape') {
          closePopup();
        } else if (e.key === 'Tab') {
          const focusable = container.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    })();
  </script>
)}
