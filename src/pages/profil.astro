---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pengaturan } from '../utils/data';
import * as profilData from '../content/data/profil.md';

const { frontmatter, Content } = profilData;

const pageTitle = frontmatter.title?.trim() || `Profil & Identitas ${pengaturan.nama_sekolah}`;
const pageDesc = frontmatter.deskripsi?.trim() || "Mengenal sejarah pengabdian, identitas resmi Kemdikbud, visi-misi pendidikan, serta makna filosofis lambang sekolah.";
const defaultHeroProfil = '/images/hero/hero-profil.webp';
const frontmatterFoto = typeof frontmatter.hero_foto === 'string' ? frontmatter.hero_foto.trim() : '';
const pengaturanFoto = typeof pengaturan.hero_pages?.profil === 'string' ? pengaturan.hero_pages.profil.trim() : '';
const heroFoto =
  (frontmatterFoto && frontmatterFoto !== defaultHeroProfil ? frontmatterFoto : '') ||
  pengaturanFoto ||
  frontmatterFoto ||
  defaultHeroProfil;
const sejarahJudul = frontmatter.sejarah_judul?.trim() || "Enam Dekade Mencerdaskan Putra-Putri Sukodono";

const visi = frontmatter.visi || "Terwujudnya Peserta Didik yang Beriman, Berakhlak Mulia, Unggul dalam Prestasi, Terampil, dan Berwawasan Lingkungan.";
const misi = Array.isArray(frontmatter.misi) && frontmatter.misi.length > 0 ? frontmatter.misi : [
  "Menanamkan keimanan, ketakwaan, dan pembiasaan akhlakul karimah dalam seluruh aktivitas warga sekolah.",
  "Melaksanakan pembelajaran yang aktif, inovatif, dan ramah anak guna meningkatkan mutu akademik siswa.",
  "Mengembangkan potensi bakat di bidang olahraga, seni drumband, kepramukaan, dan keterampilan abad ke-21.",
  "Membangun lingkungan belajar yang bersih, disiplin, harmonis, serta bersinergi dengan orang tua dan masyarakat."
];

const defaultFilosofi = [
  {
    judul: "1. Perisai Segi Lima Biru Cyan",
    penjelasan: "Melambangkan Pancasila sebagai dasar pendidikan serta keteduhan dan kejernihan berpikir seluruh warga sekolah."
  },
  {
    judul: "2. Gapura Candi Kuning Emas",
    penjelasan: "Mencerminkan akar sejarah budaya luhur Jawa Timur (semangat Wijaya) dan cita-cita mulia menuju kejayaan prestasi."
  },
  {
    judul: "3. Pena Biru Tegak Lurus",
    penjelasan: "Simbol ketekunan menuntut ilmu, kreativitas menulis karya, dan keteguhan prinsip kebenaran."
  },
  {
    judul: "4. Buku Terbuka Berwarna Putih",
    penjelasan: "Melambangkan keterbukaan terhadap ilmu pengetahuan yang dilandasi ketulusan hati dan akhlak mulia."
  }
];

const filosofiList = Array.isArray(frontmatter.filosofi_logo) && frontmatter.filosofi_logo.length > 0
  ? frontmatter.filosofi_logo
  : defaultFilosofi;
---

<BaseLayout title={`${pageTitle} — ${pengaturan.nama_sekolah}`} description={pageDesc} activeNav="profil">
  <!-- Page Header -->
  <div class="relative bg-ocean-950 text-white py-14 lg:py-20 overflow-hidden">
    <!-- Background Image with Gradient Overlay -->
    <img
      src={heroFoto}
      alt={`Sejarah Pengabdian dan Lingkungan ${pengaturan.nama_sekolah}`}
      class="absolute inset-0 w-full h-full object-cover object-center animate-hero-bg"
      width="1920"
      height="800"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-950/95 via-ocean-950/90 to-ocean-900/80"></div>
    <div class="absolute inset-0 bg-ocean-950/40"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-ocean-900/80 border border-wijayaCyan-400/30 text-xs font-mono text-wijayaCyan-300 uppercase tracking-wider mb-3 animate-hero-badge">
        Beranda / Tentang Kami
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight animate-hero-title">{pageTitle}</h1>
      <p class="text-sky-100/90 mt-3 max-w-2xl text-base sm:text-lg leading-relaxed animate-hero-desc">{pageDesc}</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">
    <!-- Identitas & Sejarah -->
    <div class="grid lg:grid-cols-12 gap-10 reveal">
      <div class="lg:col-span-7 space-y-4">
        <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Sejarah Singkat</div>
        <h2 class="text-2xl font-bold text-ocean-950">{sejarahJudul}</h2>
        <div class="text-slate-600 leading-relaxed space-y-4">
          <Content />
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-xl border border-slate-200 overflow-hidden bg-white shadow-sm card-interactive">
          <div class="bg-ocean-950 text-white px-5 py-3.5 text-sm font-bold">Data Identitas Resmi Sekolah</div>
          <dl class="divide-y divide-slate-100 text-sm">
            <div class="px-5 py-3 flex justify-between gap-4"><dt class="text-slate-500">Nama Sekolah</dt><dd class="font-semibold text-ocean-950 text-right">{pengaturan.nama_sekolah}</dd></div>
            <div class="px-5 py-3 flex justify-between gap-4"><dt class="text-slate-500">NPSN</dt><dd class="font-mono font-semibold text-cerulean-600">{pengaturan.npsn}</dd></div>
            <div class="px-5 py-3 flex justify-between gap-4"><dt class="text-slate-500">Status / Jenjang</dt><dd class="font-semibold text-ocean-950">{pengaturan.status_jenjang || 'Swasta / SMP'}</dd></div>
            <div class="px-5 py-3 flex justify-between gap-4"><dt class="text-slate-500">Akreditasi</dt><dd class="font-semibold text-ocean-950">{pengaturan.akreditasi}</dd></div>
            <div class="px-5 py-3 flex justify-between gap-4"><dt class="text-slate-500">Kepala Sekolah</dt><dd class="font-semibold text-ocean-950 text-right">{pengaturan.sambutan_kepsek.nama}</dd></div>
            <div class="px-5 py-3 flex justify-between gap-4"><dt class="text-slate-500">Alamat</dt><dd class="font-medium text-slate-700 text-right">{pengaturan.kontak.alamat}</dd></div>
            <div class="px-5 py-3 flex justify-between gap-4"><dt class="text-slate-500">Telepon</dt><dd class="font-mono font-medium text-slate-700">{pengaturan.kontak.telepon}</dd></div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Visi & Misi -->
    <div id="visi-misi" class="grid lg:grid-cols-12 gap-8 scroll-mt-24 reveal">
      <div class="lg:col-span-5 rounded-2xl bg-ocean-950 text-white p-8 border-t-4 border-candiGold-400 card-interactive">
        <div class="text-xs font-mono uppercase tracking-widest text-candiGold-400 font-semibold">Visi Sekolah</div>
        <blockquote class="text-xl sm:text-2xl font-bold leading-snug mt-3">
          "{visi}"
        </blockquote>
      </div>
      <div class="lg:col-span-7 rounded-2xl bg-slate-50 border border-slate-200 p-8 card-interactive">
        <div class="text-xs font-mono uppercase tracking-widest text-cerulean-600 font-semibold mb-4">Misi Sekolah</div>
        <ol class="space-y-3 text-sm sm:text-base text-slate-700">
          {misi.map((m: string, idx: number) => (
            <li class="flex gap-3">
              <span class="w-6 h-6 rounded-full bg-cerulean-600 text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                {idx + 1}
              </span>
              <span>{m}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Filosofi Logo (Dinamis dari CMS) -->
    <div id="filosofi" class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-10 scroll-mt-24 reveal card-interactive">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-4 flex flex-col items-center text-center">
          <div class="w-52 h-52 rounded-2xl bg-slate-50 border border-slate-200 p-5 flex items-center justify-center">
            <img src={pengaturan.logo?.trim() || '/images/logo-smp-wijaya.png'} alt={`Logo ${pengaturan.nama_sekolah}`} class="w-full h-full object-contain" />
          </div>
          <div class="mt-4 font-bold text-ocean-950">Lambang Resmi {pengaturan.nama_sekolah}</div>
          <div class="text-xs text-slate-500 mt-1">Sumber palet warna resmi identitas digital sekolah</div>
        </div>
        <div class="lg:col-span-8 space-y-4">
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Filosofi Lambang</div>
          <h2 class="text-2xl font-bold text-ocean-950">Makna Unsur pada Logo Sekolah</h2>
          <div class="grid sm:grid-cols-2 gap-4 pt-2">
            {filosofiList.map((item: { judul: string; penjelasan: string }) => (
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <div class="font-bold text-ocean-950 text-sm">{item.judul}</div>
                <p class="text-xs sm:text-sm text-slate-600 mt-1">{item.penjelasan}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
