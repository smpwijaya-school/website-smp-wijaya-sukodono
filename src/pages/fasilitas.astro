---
import BaseLayout from '../layouts/BaseLayout.astro';
import FacilityModal from '../components/FacilityModal.astro';
import { fasilitasData, pengaturan } from '../utils/data';

const allFacilities = fasilitasData.daftar;
const defaultCategories = ['Semua', 'Akademik', 'Laboratorium', 'Olahraga & Ibadah'];
const categories = ['Semua', ...new Set([...defaultCategories.slice(1), ...allFacilities.map(f => f.kategori).filter(Boolean)])];
const heroFoto = pengaturan.hero_pages?.fasilitas || '/images/hero/hero-fasilitas.webp';
---

<BaseLayout
  title={`Fasilitas & Sarana Prasarana — ${pengaturan.nama_sekolah}`}
  description={`Fasilitas belajar yang mendukung kegiatan akademik, praktikum sains, olahraga, dan pembinaan ibadah siswa di ${pengaturan.nama_sekolah}.`}
  activeNav="fasilitas"
>
  <!-- Page Header -->
  <div class="relative bg-ocean-950 text-white py-14 lg:py-20 overflow-hidden">
    <!-- Background Image with Gradient Overlay -->
    <img
      src={heroFoto}
      alt={`Sarana Prasarana dan Fasilitas Sekolah ${pengaturan.nama_sekolah}`}
      class="absolute inset-0 w-full h-full object-cover object-center animate-hero-bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-950/95 via-ocean-950/90 to-ocean-900/80"></div>
    <div class="absolute inset-0 bg-ocean-950/40"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-ocean-900/80 border border-wijayaCyan-400/30 text-xs font-mono text-wijayaCyan-300 uppercase tracking-wider mb-3 animate-hero-badge">
        Beranda / Fasilitas
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight animate-hero-title">Sarana &amp; Prasarana Sekolah</h1>
      <p class="text-sky-100/90 mt-3 max-w-2xl text-base sm:text-lg leading-relaxed animate-hero-desc">Fasilitas belajar yang mendukung kegiatan akademik, praktikum sains &amp; komputer, olahraga, serta pembinaan ibadah siswa.</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Filter Tabs -->
    <div class="flex flex-wrap gap-2 mb-8 reveal" id="facility-filter-tabs">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat}
          class={`filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition ${
            idx === 0 ? 'bg-ocean-950 text-white active' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Grid Cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="facilities-grid">
      {allFacilities.map((f, idx) => (
        <div
          class={`facility-card bg-white rounded-xl border border-slate-200 overflow-hidden card-interactive transition flex flex-col reveal delay-${(idx % 3 + 1) * 75}`}
          data-cat={f.kategori}
        >
          <div class="aspect-[4/3] bg-gradient-to-br from-ocean-950 to-ocean-900 p-5 flex flex-col justify-between relative overflow-hidden">
            {f.foto && (
              <img src={f.foto} alt={f.nama} class="absolute inset-0 w-full h-full object-cover transition duration-300 hover:scale-105" onerror="this.style.display='none';" />
              <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-ocean-950/30 to-ocean-950/40"></div>
            )}
            <span class="relative z-10 self-start px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-sm text-sky-100 font-mono text-[11px] font-semibold">{f.kategori}</span>
            <div class="relative z-10 flex items-center justify-between gap-2">
              <span class="text-white font-bold text-base drop-shadow-md truncate">{f.nama}</span>
              <button
                type="button"
                data-facility={JSON.stringify(f)}
                class="open-facility-modal-btn px-3 py-1.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 text-xs font-bold transition shrink-0 shadow-md"
              >
                Lihat Foto
              </button>
            </div>
          </div>
          <div class="p-5 flex-1">
            <h3 class="font-bold text-ocean-950 text-base">{f.nama}</h3>
            <p class="text-sm text-slate-600 mt-1.5 leading-relaxed">{f.deskripsi}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <FacilityModal />

  <script is:inline>
    const filterBtns = document.querySelectorAll('#facility-filter-tabs .filter-btn');
    const cards = document.querySelectorAll('.facility-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-ocean-950', 'text-white', 'active');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-ocean-950', 'text-white', 'active');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        const cat = btn.getAttribute('data-category');
        cards.forEach(card => {
          const itemCat = card.getAttribute('data-cat');
          if (cat === 'Semua' || itemCat === cat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</BaseLayout>
