---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pengaturan } from '../../utils/data';

const allBerita = await getCollection('berita', ({ data }) => !data.draft);
const sortedBerita = allBerita.sort((a, b) => b.data.tanggal.getTime() - a.data.tanggal.getTime());

const featuredNews = sortedBerita[0];
const remainingNews = sortedBerita.slice(1);

const defaultCategories = ['Semua', 'Kegiatan', 'Prestasi', 'Pengumuman', 'Akademik'];
const extractedCategories = allBerita.map(b => b.data.kategori).filter(Boolean);
const categories = ['Semua', ...new Set([...defaultCategories.slice(1), ...extractedCategories])];

const heroJudul = pengaturan.halaman_berita?.judul?.trim() || 'Berita, Prestasi & Pengumuman';
const heroDeskripsi = pengaturan.halaman_berita?.deskripsi?.trim() || `Dokumentasi kegiatan siswa, prestasi ekstrakurikuler, serta pengumuman resmi dari ${pengaturan.nama_sekolah}.`;
const heroFoto = pengaturan.halaman_berita?.foto?.trim() || pengaturan.hero_pages?.berita || '/images/hero/hero-berita.webp';

function formatDate(date: Date) {
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
}
---

<BaseLayout title={`${heroJudul} — ${pengaturan.nama_sekolah}`} description={heroDeskripsi} activeNav="berita">
  <!-- Page Header -->
  <div class="relative bg-ocean-950 text-white py-14 lg:py-20 overflow-hidden">
    <!-- Background Image with Gradient Overlay -->
    <img
      src={heroFoto}
      alt={`Dokumentasi Prestasi dan Kegiatan ${pengaturan.nama_sekolah}`}
      class="absolute inset-0 w-full h-full object-cover object-center animate-hero-bg"
      width="1920"
      height="800"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-950/95 via-ocean-950/90 to-ocean-900/80"></div>
    <div class="absolute inset-0 bg-ocean-950/40"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-ocean-900/80 border border-wijayaCyan-400/30 text-xs font-mono text-wijayaCyan-300 uppercase tracking-wider mb-3 animate-hero-badge">
        Beranda / Berita
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight animate-hero-title">{heroJudul}</h1>
      <p class="text-sky-100/90 mt-3 max-w-2xl text-base sm:text-lg leading-relaxed animate-hero-desc">{heroDeskripsi}</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <!-- Filter & Search Controls -->
    <div class="flex flex-col md:flex-row gap-4 justify-between items-stretch md:items-center reveal">
      <div class="flex flex-wrap gap-2" id="news-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`news-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition ${
              idx === 0 ? 'bg-ocean-950 text-white active' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
      <div class="relative w-full md:w-72">
        <label for="news-search" class="sr-only">Cari judul berita</label>
        <input
          id="news-search"
          type="text"
          placeholder="Cari judul berita..."
          aria-label="Cari judul berita"
          class="w-full pl-4 pr-10 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-cerulean-600 focus:border-cerulean-600"
        />
        <svg class="w-4 h-4 text-slate-400 absolute right-3.5 top-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      </div>
    </div>

    {featuredNews && (
      <div id="featured-news-container" class="reveal">
        <a
          href={`/berita/${featuredNews.id}`}
          class="news-item grid lg:grid-cols-12 rounded-2xl border border-slate-200 bg-white overflow-hidden card-interactive transition group"
          data-category={featuredNews.data.kategori}
          data-title={featuredNews.data.title.toLowerCase()}
          data-summary={featuredNews.data.ringkasan.toLowerCase()}
        >
          <div class="lg:col-span-5 min-h-[220px] bg-gradient-to-br from-ocean-950 to-ocean-900 p-6 flex flex-col justify-between relative overflow-hidden group">
            {featuredNews.data.thumbnail ? (
              <>
                <img
                  src={featuredNews.data.thumbnail}
                  alt={featuredNews.data.title}
                  class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-ocean-950/30 to-black/40"></div>
              </>
            ) : null}
            <span class="relative z-10 self-start px-3 py-1 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-xs font-bold shadow-sm">
              {featuredNews.data.kategori} &bull; TERBARU
            </span>
            <div class="relative z-10 text-sky-200 font-mono text-xs drop-shadow">{formatDate(featuredNews.data.tanggal)}</div>
          </div>
          <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-center">
            <h2 class="text-xl sm:text-2xl font-bold text-ocean-950 leading-snug group-hover:text-cerulean-600 transition">
              {featuredNews.data.title}
            </h2>
            <p class="text-slate-600 mt-3 leading-relaxed">{featuredNews.data.ringkasan}</p>
            <div class="pt-5 text-sm font-semibold text-cerulean-600 flex items-center gap-1">
              <span>Baca Artikel Lengkap</span>
              <span>&rarr;</span>
            </div>
          </div>
        </a>
      </div>
    )}

    <!-- Remaining News Grid -->
    <div id="all-news-grid" class="grid md:grid-cols-3 gap-6">
      {remainingNews.map((item, idx) => (
        <a
          href={`/berita/${item.id}`}
          class={`news-item bg-white rounded-xl border border-slate-200 overflow-hidden card-interactive transition flex flex-col group reveal delay-${(idx % 3 + 1) * 100}`}
          data-category={item.data.kategori}
          data-title={item.data.title.toLowerCase()}
          data-summary={item.data.ringkasan.toLowerCase()}
        >
          <div class="aspect-video bg-gradient-to-br from-ocean-950 to-ocean-900 p-4 flex flex-col justify-between relative overflow-hidden group">
            {item.data.thumbnail ? (
              <>
                <img
                  src={item.data.thumbnail}
                  alt={item.data.title}
                  class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-ocean-950/20 to-black/30"></div>
              </>
            ) : null}
            <span class="relative z-10 self-start px-2.5 py-1 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-[11px] font-bold shadow-sm">
              {item.data.kategori}
            </span>
            <div class="relative z-10 flex items-center justify-between text-sky-200 text-xs font-mono drop-shadow">
              <span>{formatDate(item.data.tanggal)}</span>
              <span>{pengaturan.nama_sekolah}</span>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <h3 class="font-bold text-ocean-950 text-base leading-snug line-clamp-2 group-hover:text-cerulean-600 transition">
              {item.data.title}
            </h3>
            <p class="text-sm text-slate-600 mt-2 line-clamp-3 flex-1">{item.data.ringkasan}</p>
            <div class="pt-4 text-sm font-semibold text-cerulean-600 flex items-center gap-1">
              <span>Baca Selengkapnya</span>
              <span>&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div id="no-news-found" class="hidden text-center py-12 text-slate-500 text-sm">
      Belum ada berita untuk filter atau kata kunci ini.
    </div>
  </div>

  <script is:inline>
    const filterBtns = document.querySelectorAll('#news-filters .news-filter-btn');
    const searchInput = document.getElementById('news-search');
    const items = document.querySelectorAll('.news-item');
    const noResults = document.getElementById('no-news-found');

    let currentCat = 'Semua';

    function applyNewsFilters() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      items.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        const itemTitle = item.getAttribute('data-title');
        const itemSummary = item.getAttribute('data-summary');

        const matchCat = currentCat === 'Semua' || itemCat === currentCat;
        const matchQuery = !q || itemTitle.includes(q) || itemSummary.includes(q);

        if (matchCat && matchQuery) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-ocean-950', 'text-white', 'active');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-ocean-950', 'text-white', 'active');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        currentCat = btn.getAttribute('data-category');
        applyNewsFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', applyNewsFilters);
    }
  </script>
</BaseLayout>
