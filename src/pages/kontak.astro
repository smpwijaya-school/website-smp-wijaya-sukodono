---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pengaturan } from '../utils/data';

const cleanWa = (pengaturan.kontak.whatsapp || '').replace(/\D/g, '').replace(/^0/, '62');
const heroFoto = pengaturan.hero_pages?.kontak || '/images/hero/hero-kontak.webp';
const jamLayanan = pengaturan.kontak.jam_layanan || 'Senin – Sabtu, 07.30 – 13.00 WIB (Minggu & Hari Libur Nasional tutup)';
const mapsSrc = pengaturan.kontak.maps_url || `https://www.google.com/maps?q=${encodeURIComponent(pengaturan.nama_sekolah + ' ' + pengaturan.kontak.alamat)}&output=embed`;
---

<BaseLayout
  title={`Hubungi Kami — ${pengaturan.nama_sekolah}`}
  description={`Informasi kontak resmi ${pengaturan.nama_sekolah}, ${pengaturan.kontak.alamat}: nomor telepon, WhatsApp Tata Usaha, email, dan peta lokasi.`}
  activeNav="kontak"
>
  <!-- Page Header -->
  <div class="relative bg-ocean-950 text-white py-14 lg:py-20 overflow-hidden">
    <!-- Background Image with Gradient Overlay -->
    <img
      src={heroFoto}
      alt={`Layanan Informasi dan Tata Usaha ${pengaturan.nama_sekolah}`}
      class="absolute inset-0 w-full h-full object-cover object-center animate-hero-bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-950/95 via-ocean-950/90 to-ocean-900/80"></div>
    <div class="absolute inset-0 bg-ocean-950/40"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-ocean-900/80 border border-wijayaCyan-400/30 text-xs font-mono text-wijayaCyan-300 uppercase tracking-wider mb-3 animate-hero-badge">
        Beranda / Kontak
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight animate-hero-title">Hubungi {pengaturan.nama_sekolah}</h1>
      <p class="text-sky-100/90 mt-3 max-w-2xl text-base sm:text-lg leading-relaxed animate-hero-desc">Informasi alamat resmi, nomor telepon kantor, layanan WhatsApp Tata Usaha, dan peta lokasi sekolah.</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid lg:grid-cols-12 gap-8">
      <!-- Contact Info Cards -->
      <div class="lg:col-span-5 space-y-5 reveal">
        <div class="rounded-2xl border border-slate-200 p-6 bg-white space-y-5 shadow-sm card-interactive">
          <div>
            <div class="text-xs font-mono uppercase text-cerulean-600 font-semibold">Alamat Sekolah</div>
            <p class="font-semibold text-ocean-950 mt-1 leading-relaxed">{pengaturan.kontak.alamat}</p>
          </div>
          <div>
            <div class="text-xs font-mono uppercase text-cerulean-600 font-semibold">Telepon Kantor</div>
            <p class="font-mono font-semibold text-ocean-950 mt-1">{pengaturan.kontak.telepon}</p>
          </div>
          <div>
            <div class="text-xs font-mono uppercase text-cerulean-600 font-semibold">Email Resmi</div>
            <p class="font-mono text-sm font-semibold text-ocean-950 mt-1">
              <a href={`mailto:${pengaturan.kontak.email}`} class="hover:text-cerulean-600 transition">
                {pengaturan.kontak.email}
              </a>
            </p>
          </div>
          <div>
            <div class="text-xs font-mono uppercase text-cerulean-600 font-semibold">Jam Layanan Tata Usaha</div>
            <p class="text-sm text-slate-600 mt-1 leading-relaxed">{jamLayanan}</p>
          </div>
          {pengaturan.kontak.instagram && (
            <div>
              <div class="text-xs font-mono uppercase text-cerulean-600 font-semibold">Instagram Resmi</div>
              <p class="text-sm font-semibold text-ocean-950 mt-1">
                <a
                  href={pengaturan.kontak.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-cerulean-600 hover:text-cerulean-700 underline underline-offset-4 transition inline-flex items-center gap-1.5"
                >
                  <span>Kunjungi Akun Instagram Sekolah</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </p>
            </div>
          )}
          <div class="pt-2">
            <a
              href={`https://wa.me/${cleanWa}?text=Halo%20Tata%20Usaha%20${encodeURIComponent(pengaturan.nama_sekolah)},%20saya%20ingin%20menanyakan%20informasi%20sekolah.`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-sm transition"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2z" />
              </svg>
              <span>Chat WhatsApp Tata Usaha</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Google Maps Embed -->
      <div class="lg:col-span-7 reveal delay-100">
        <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-100 h-[420px] shadow-sm card-interactive">
          <iframe
            title={`Peta Lokasi ${pengaturan.nama_sekolah}`}
            src={mapsSrc}
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
