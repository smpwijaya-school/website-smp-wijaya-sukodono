---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guruData, pengaturan } from '../utils/data';
import type { GuruItem } from '../content.config';

const allGuru = (guruData.daftar || []) as GuruItem[];
const defaultCategories = ['Semua', 'Pimpinan', 'Guru Mapel', 'Staf TU'];
const categories = ['Semua', ...new Set([...defaultCategories.slice(1), ...allGuru.map(g => g.bidang).filter(Boolean)])];
const heroFoto = pengaturan.hero_pages?.guru || '/images/hero/hero-guru.webp';
---

<BaseLayout
  title={`Direktori Guru & Staf — ${pengaturan.nama_sekolah}`}
  description={`Daftar tenaga pendidik profesional dan staf kependidikan ${pengaturan.nama_sekolah} yang mendampingi proses belajar siswa.`}
  activeNav="guru"
>
  <!-- Page Header -->
  <div class="relative bg-ocean-950 text-white py-14 lg:py-20 overflow-hidden">
    <!-- Background Image with Gradient Overlay -->
    <img
      src={heroFoto}
      alt={`Dewan Guru dan Tenaga Pendidik ${pengaturan.nama_sekolah}`}
      class="absolute inset-0 w-full h-full object-cover object-center animate-hero-bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-950/95 via-ocean-950/90 to-ocean-900/80"></div>
    <div class="absolute inset-0 bg-ocean-950/40"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-ocean-900/80 border border-wijayaCyan-400/30 text-xs font-mono text-wijayaCyan-300 uppercase tracking-wider mb-3 animate-hero-badge">
        Beranda / Guru &amp; Staf
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight animate-hero-title">Direktori Tenaga Pendidik &amp; Kependidikan</h1>
      <p class="text-sky-100/90 mt-3 max-w-2xl text-base sm:text-lg leading-relaxed animate-hero-desc">Tenaga pengajar berdedikasi dan staf Tata Usaha yang mendampingi perkembangan akademik dan karakter siswa SMP Wijaya Sukodono.</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <!-- Search & Filter Controls -->
    <div class="flex flex-col md:flex-row gap-4 justify-between items-stretch md:items-center reveal">
      <div class="flex flex-wrap gap-2" id="teacher-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`teacher-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition ${
              idx === 0 ? 'bg-ocean-950 text-white active' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
      <div class="relative w-full md:w-72">
        <label for="teacher-search" class="sr-only">Cari nama guru atau mata pelajaran</label>
        <input
          id="teacher-search"
          type="text"
          placeholder="Cari nama atau mata pelajaran..."
          aria-label="Cari nama guru atau mata pelajaran"
          class="w-full pl-4 pr-10 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-cerulean-600 focus:border-cerulean-600"
        />
        <svg class="w-4 h-4 text-slate-400 absolute right-3.5 top-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      </div>
    </div>

    <!-- Cards Grid -->
    <div id="teachers-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {allGuru.map((g, idx) => {
        const isLeader = g.bidang === 'Pimpinan';
        return (
          <div
            class={`teacher-card bg-white rounded-xl border ${isLeader ? 'border-cerulean-600/40 ring-1 ring-cerulean-600/10' : 'border-slate-200'} overflow-hidden card-interactive transition flex flex-col group reveal delay-${(idx % 4 + 1) * 75}`}
            data-bidang={g.bidang}
            data-name={g.nama.toLowerCase()}
            data-role={g.jabatan.toLowerCase()}
          >
            <div class={`aspect-square w-full overflow-hidden relative ${g.foto ? 'bg-slate-100' : (isLeader ? 'bg-ocean-950 text-candiGold-400' : 'bg-wijayaCyan-50 text-cerulean-600')} flex items-center justify-center`}>
              {g.foto ? (
                <>
                  <img
                    src={g.foto}
                    alt={g.nama}
                    class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105"
                    loading="lazy"
                    onerror="this.style.display='none';this.nextElementSibling?.classList.remove('hidden');"
                  />
                  <span class={`hidden text-4xl font-extrabold tracking-tight ${isLeader ? 'text-candiGold-400' : 'text-cerulean-600'}`}>
                    {g.inisial || g.nama.slice(0, 2).toUpperCase()}
                  </span>
                </>
              ) : (
                <span class="text-4xl font-extrabold tracking-tight">
                  {g.inisial || g.nama.slice(0, 2).toUpperCase()}
                </span>
              )}
            </div>
            <div class="p-4 sm:p-5 text-center flex-1 flex flex-col items-center justify-center">
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 font-mono text-[11px] font-semibold mb-2">
                {g.bidang}
              </span>
              <h3 class="font-bold text-ocean-950 text-base leading-snug group-hover:text-cerulean-600 transition">{g.nama}</h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-1">{g.jabatan}</p>
            </div>
          </div>
        );
      })}
    </div>
    <div id="no-teachers-found" class="hidden text-center py-12 text-slate-500 text-sm">
      Data guru atau staf tidak ditemukan.
    </div>
  </div>

  <script is:inline>
    const filterBtns = document.querySelectorAll('#teacher-filters .teacher-filter-btn');
    const searchInput = document.getElementById('teacher-search');
    const cards = document.querySelectorAll('.teacher-card');
    const noResults = document.getElementById('no-teachers-found');

    let currentBidang = 'Semua';

    function applyFilters() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach(card => {
        const itemBidang = card.getAttribute('data-bidang');
        const itemName = card.getAttribute('data-name');
        const itemRole = card.getAttribute('data-role');

        const matchCat = currentBidang === 'Semua' || itemBidang === currentBidang;
        const matchQuery = !q || itemName.includes(q) || itemRole.includes(q);

        if (matchCat && matchQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-ocean-950', 'text-white', 'active');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-ocean-950', 'text-white', 'active');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        currentBidang = btn.getAttribute('data-category');
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }
  </script>
</BaseLayout>
