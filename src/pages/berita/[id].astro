---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { pengaturan } from '../../utils/data';

export async function getStaticPaths() {
  const posts = await getCollection('berita', ({ data }) => !data.draft);
  return posts.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allPosts = await getCollection('berita', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.id !== entry.id)
  .sort((a, b) => b.data.tanggal.getTime() - a.data.tanggal.getTime())
  .slice(0, 2);

function formatDate(date: Date) {
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
}
---

<BaseLayout title={`${entry.data.title} — ${pengaturan.nama_sekolah}`} description={entry.data.ringkasan} activeNav="berita">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/berita" class="inline-flex items-center gap-1.5 text-sm font-semibold text-cerulean-600 hover:text-cerulean-700 mb-6">
      &larr; Kembali ke Daftar Berita
    </a>

    <article>
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono mb-4">
        <span class="px-2.5 py-1 rounded-full bg-wijayaCyan-50 text-cerulean-600 font-bold">{entry.data.kategori}</span>
        <span class="text-slate-500">{formatDate(entry.data.tanggal)}</span>
        <span class="text-slate-400">&bull; Admin {pengaturan.nama_sekolah}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-ocean-950 leading-tight">
        {entry.data.title}
      </h1>

      <!-- Visual Cover -->
      <div class="my-6 aspect-video rounded-2xl bg-gradient-to-br from-ocean-950 to-ocean-900 flex flex-col items-center justify-center p-8 text-center text-white relative overflow-hidden">
        {entry.data.thumbnail ? (
          <img src={entry.data.thumbnail} alt={entry.data.title} class="w-full h-full object-cover" />
        ) : (
          <>
            <img src={pengaturan.halaman_berita?.foto?.trim() || pengaturan.hero_pages?.berita || '/images/hero/hero-berita.webp'} alt="" class="absolute inset-0 w-full h-full object-cover opacity-25" />
            <div class="absolute inset-0 bg-ocean-950/70"></div>
            <div class="w-16 h-16 mb-3 opacity-90 relative z-10">
              <img src={pengaturan.logo?.trim() || '/images/logo-smp-wijaya.png'} alt={`Logo ${pengaturan.nama_sekolah}`} class="w-full h-full object-contain" />
            </div>
            <div class="text-sm font-semibold text-sky-100 relative z-10">Dokumentasi &amp; Prestasi {pengaturan.nama_sekolah}</div>
          </>
        )}
      </div>

      <!-- Article Body -->
      <div class="prose prose-slate max-w-none text-base sm:text-[17px] text-slate-700 leading-[1.8] space-y-4">
        <Content />
      </div>

      <!-- Share Buttons -->
      <div class="mt-8 p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-wrap items-center justify-between gap-3">
        <span class="text-sm font-semibold text-ocean-950">Bagikan kabar sekolah ini:</span>
        <div class="flex gap-2">
          <button
            type="button"
            onclick="window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(document.title + ' ' + window.location.href), '_blank')"
            class="px-4 py-2 rounded-lg bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700 transition"
          >
            Share WhatsApp
          </button>
          <button
            type="button"
            onclick="navigator.clipboard.writeText(window.location.href); window.showToast('Tautan artikel berhasil disalin!');"
            class="px-4 py-2 rounded-lg border border-slate-300 bg-white text-ocean-950 text-xs font-semibold hover:bg-slate-100 transition"
          >
            Salin Tautan
          </button>
        </div>
      </div>
    </article>

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <div class="mt-12 pt-8 border-t border-slate-200">
        <h3 class="text-lg font-bold text-ocean-950 mb-5">Berita Lainnya</h3>
        <div class="grid sm:grid-cols-2 gap-5">
          {relatedPosts.map(p => (
            <a href={`/berita/${p.id}`} class="bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md transition flex flex-col group">
              <div class="aspect-video bg-gradient-to-br from-ocean-950 to-ocean-900 p-4 flex flex-col justify-between">
                <span class="self-start px-2 py-0.5 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-[10px] font-bold">{p.data.kategori}</span>
                <span class="text-sky-200 font-mono text-xs">{formatDate(p.data.tanggal)}</span>
              </div>
              <div class="p-4 flex-1 flex flex-col">
                <h4 class="font-bold text-ocean-950 text-sm leading-snug line-clamp-2 group-hover:text-cerulean-600 transition">{p.data.title}</h4>
                <div class="pt-3 text-xs font-semibold text-cerulean-600 mt-auto">Baca Selengkapnya &rarr;</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
