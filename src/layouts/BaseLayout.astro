---
import '../styles/global.css';
import TopBarSPMB from '../components/TopBarSPMB.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { pengaturan, spmb } from '../utils/data';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
  image?: string;
}

const defaultTitle = `${pengaturan.nama_sekolah} — Website Resmi Sekolah (NPSN: ${pengaturan.npsn})`;
const defaultDesc = `Website resmi ${pengaturan.nama_sekolah}, ${pengaturan.kontak.alamat}. Informasi profil sekolah, fasilitas, direktori guru, berita prestasi, dan SPMB ${spmb.tahun_ajaran}.`;

const {
  title = defaultTitle,
  description = defaultDesc,
  activeNav = 'home',
  image = '/images/logo-smp-wijaya.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://smpwijayasukodono.sch.id');
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- OpenGraph / WhatsApp Meta Tags -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />

  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Preload Critical Hero Image on Home -->
  {activeNav === 'home' && (
    <link rel="preload" as="image" href={pengaturan.hero?.foto || '/images/hero/hero-home.webp'} fetchpriority="high" />
  )}

  <slot name="head" />
</head>
<body class="antialiased selection:bg-cerulean-600 selection:text-white bg-white text-slate-900 min-h-screen flex flex-col">
  <!-- Reusable SVG Definition -->
  <svg class="hidden" aria-hidden="true">
    <defs>
      <g id="logo-smp-wijaya">
        <!-- Pentagonal Cyan Shield -->
        <polygon points="100,10 186,68 158,186 42,186 14,68" fill="#38F2FF" stroke="#082F49" stroke-width="6" stroke-linejoin="round" />
        <polygon points="100,17 179,71 153,180 47,180 21,71" fill="none" stroke="#0284C7" stroke-width="1.5" stroke-opacity="0.4" />
        <!-- Curved Text Top -->
        <path id="topArcLeft" d="M 32,80 L 96,35" fill="none" />
        <path id="topArcRight" d="M 104,35 L 168,80" fill="none" />
        <text font-family="'Plus Jakarta Sans', sans-serif" font-size="11.5" font-weight="800" fill="#082F49" letter-spacing="0.4">
          <textPath href="#topArcLeft" startOffset="50%" text-anchor="middle">SEKOLAH MENE</textPath>
        </text>
        <text font-family="'Plus Jakarta Sans', sans-serif" font-size="11.5" font-weight="800" fill="#082F49" letter-spacing="0.4">
          <textPath href="#topArcRight" startOffset="50%" text-anchor="middle">NGAH PERTAMA</textPath>
        </text>
        <!-- Left Stepped Majapahit Candi Gate (Gold) -->
        <g fill="#FACC15" stroke="#082F49" stroke-width="3.2" stroke-linejoin="round">
          <rect x="78" y="62" width="12" height="14" />
          <rect x="69" y="76" width="21" height="13" />
          <rect x="61" y="89" width="29" height="13" />
          <rect x="52" y="102" width="38" height="14" />
          <polygon points="44,116 90,116 90,129 36,129" />
        </g>
        <!-- Right Stepped Majapahit Candi Gate (Gold) -->
        <g fill="#FACC15" stroke="#082F49" stroke-width="3.2" stroke-linejoin="round">
          <rect x="110" y="62" width="12" height="14" />
          <rect x="110" y="76" width="21" height="13" />
          <rect x="110" y="89" width="29" height="13" />
          <rect x="110" y="102" width="38" height="14" />
          <polygon points="110,116 156,116 164,129 110,129" />
        </g>
        <!-- Open White Book -->
        <path d="M 100,111 C 87,104 71,105 64,114 L 62,147 C 72,141 88,142 100,149 C 112,142 128,141 138,147 L 136,114 C 129,105 113,104 100,111 Z" fill="#FFFFFF" stroke="#082F49" stroke-width="3.5" stroke-linejoin="round" />
        <line x1="100" y1="112" x2="100" y2="148" stroke="#082F49" stroke-width="2.5" />
        <!-- Central Cerulean Fountain Pen -->
        <path d="M 96,55 L 104,55 L 104,114 L 107,124 L 100,136 L 93,124 L 96,114 Z" fill="#0284C7" stroke="#082F49" stroke-width="3" stroke-linejoin="round" />
        <circle cx="100" cy="123" r="2.2" fill="#FFFFFF" />
        <circle cx="100" cy="142" r="3" fill="#0284C7" stroke="#082F49" stroke-width="2" />
        <!-- Bottom Title -->
        <text x="100" y="164" text-anchor="middle" font-family="Georgia, serif" font-size="18" font-weight="900" fill="#082F49" letter-spacing="0.8">WIJAYA</text>
        <text x="100" y="177" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="11.5" font-weight="800" fill="#082F49" letter-spacing="0.6">SUKODONO</text>
      </g>
    </defs>
  </svg>

  <TopBarSPMB />
  <Navbar activeNav={activeNav} />
  
  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <Footer />

  <!-- Global Toast -->
  <div id="toast" class="hidden fixed bottom-10 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-xl bg-ocean-950 text-white text-sm font-medium shadow-xl border border-wijayaCyan-500/40 transition"></div>

  <!-- Scroll-Driven Reveal Observer -->
  <script is:inline>
    (function initScrollReveal() {
      if (typeof window === 'undefined') return;
      
      const reveals = document.querySelectorAll('.reveal');
      if (!reveals.length) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        reveals.forEach(el => el.classList.add('reveal-visible'));
        return;
      }

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            obs.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -40px 0px'
      });

      reveals.forEach(el => observer.observe(el));
    })();

    window.showToast = function(msg) {
      const el = document.getElementById('toast');
      if (!el) return;
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => el.classList.add('hidden'), 3200);
    };
  </script>
</body>
</html>
