---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ekskulData, spmb, pengaturan } from '../utils/data';
import EkskulModal from '../components/EkskulModal.astro';

const allEkskul = ekskulData.daftar;
const defaultCategories = ['Semua', 'Olahraga', 'Seni & Budaya', 'Kepemimpinan', 'Keagamaan', 'Minat & Bakat'];
const categories = ['Semua', ...new Set([...defaultCategories.slice(1), ...allEkskul.map(e => e.kategori).filter(Boolean)])];
const heroJudul = ekskulData.hero?.judul?.trim() || 'Ekstrakurikuler & Minat Bakat';
const heroDeskripsi = ekskulData.hero?.deskripsi?.trim() || `Membina potensi peserta didik melalui wadah olahraga prestasi, seni kreasi, kedisiplinan kepemimpinan, dan kecintaan nilai religius di ${pengaturan.nama_sekolah}.`;
const heroFoto = ekskulData.hero?.foto?.trim() || pengaturan.hero_pages?.ekskul || '/images/hero/hero-ekskul.webp';
const ctaBadge = ekskulData.cta?.badge?.trim() || 'Penerimaan Murid Baru';
const ctaJudul = ekskulData.cta?.judul?.trim() || `Asah Bakat dan Ukir Prestasi di ${pengaturan.nama_sekolah}`;
const ctaDeskripsi = ekskulData.cta?.deskripsi?.trim() || 'Seluruh siswa kelas VII mendapatkan kesempatan bebas memilih ekstrakurikuler sesuai bakat dan minat masing-masing dengan fasilitas latihan yang memadai dan pembina yang berpengalaman.';
---

<BaseLayout
  title={`${heroJudul} — ${pengaturan.nama_sekolah}`}
  description={heroDeskripsi}
  activeNav="ekskul"
>
  <!-- Page Header -->
  <div class="relative bg-ocean-950 text-white py-14 lg:py-20 overflow-hidden">
    <!-- Background Image with Gradient Overlay -->
    <img
      src={heroFoto}
      alt={`Kegiatan Ekstrakurikuler dan Pengembangan Minat Bakat Siswa ${pengaturan.nama_sekolah}`}
      class="absolute inset-0 w-full h-full object-cover object-center animate-hero-bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-950/95 via-ocean-950/90 to-ocean-900/80"></div>
    <div class="absolute inset-0 bg-ocean-950/40"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-ocean-900/80 border border-wijayaCyan-400/30 text-xs font-mono text-wijayaCyan-300 uppercase tracking-wider mb-3 animate-hero-badge">
        Beranda / Ekstrakurikuler
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight animate-hero-title">
        {heroJudul}
      </h1>
      <p class="text-sky-100/90 mt-3 max-w-2xl text-base sm:text-lg leading-relaxed animate-hero-desc">
        {heroDeskripsi}
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 mb-8 reveal" id="ekskul-filter-tabs">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat}
          class={`filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition ${
            idx === 0 ? 'bg-ocean-950 text-white active' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Grid Cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="ekskul-grid">
      {allEkskul.map((item, idx) => {
        const totalPhotos = (item.foto ? 1 : 0) + (Array.isArray(item.galeri) ? item.galeri.length : 0);
        return (
          <div
            class={`ekskul-card bg-white rounded-xl border border-slate-200 overflow-hidden card-interactive transition flex flex-col justify-between reveal delay-${(idx % 3 + 1) * 75} group`}
            data-cat={item.kategori}
          >
            <div>
              <!-- Visual Header: Activity Photo & Badges -->
              <div class="aspect-[16/10] bg-gradient-to-br from-ocean-950 to-ocean-900 relative overflow-hidden">
                {item.foto ? (
                  <>
                    <img
                      src={item.foto}
                      alt={item.nama}
                      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-ocean-950/20 to-black/30"></div>
                  </>
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-white/40">
                    <svg class="w-16 h-16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                    </svg>
                  </div>
                )}

                <!-- Category Badge & Special Badge -->
                <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2 z-10">
                  <span class="px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white font-mono text-[11px] font-semibold">
                    {item.kategori}
                  </span>
                  {item.badge && (
                    <span class={`px-2.5 py-1 rounded-full font-mono text-[11px] font-bold shadow-sm ${
                      item.badge.toLowerCase().includes('wajib')
                        ? 'bg-amber-400 text-amber-950'
                        : 'bg-candiGold-400 text-ocean-950'
                    }`}>
                      {item.badge}
                    </span>
                  )}
                </div>

                <!-- Bottom Bar over Photo: Title & Photo Count / Trigger -->
                <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between gap-2 z-10">
                  <span class="text-white font-bold text-sm sm:text-base leading-tight drop-shadow truncate pr-2">
                    {item.nama}
                  </span>

                  <button
                    type="button"
                    data-ekskul={JSON.stringify(item)}
                    class="open-ekskul-modal-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 text-xs font-bold transition shrink-0 shadow-md transform active:scale-95"
                    aria-label={`Lihat foto ${item.nama}`}
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                    </svg>
                    <span>
                      {totalPhotos > 1 ? `${totalPhotos} Foto` : 'Lihat Foto'}
                    </span>
                  </button>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-5 space-y-3.5">
                <h2 class="text-base font-bold text-ocean-950 leading-snug">
                  {item.nama}
                </h2>

                <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">
                  {item.deskripsi}
                </p>

                {item.prestasi && (
                  <div class="p-3 rounded-lg bg-amber-50/70 border border-amber-200/80 flex items-start gap-2 text-xs text-amber-950 leading-relaxed">
                    <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.504-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.004-6.75V3.75a1.5 1.5 0 00-1.5-1.5h-3a1.5 1.5 0 00-1.5 1.5v4.5m9 3a4.5 4.5 0 01-9 0m9 0a4.5 4.5 0 01-9 0m9 0c0 1.657-1.343 3-3 3h-3c-1.657 0-3-1.343-3-3" />
                    </svg>
                    <div>
                      <span class="font-bold text-amber-900">Prestasi: </span>
                      <span>{item.prestasi}</span>
                    </div>
                  </div>
                )}
              </div>
            </div>

            <!-- Card Footer (Meta: Jadwal & Lokasi + Button) -->
            <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 text-xs text-slate-600 space-y-2">
              {item.jadwal && (
                <div class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="font-medium text-slate-700">{item.jadwal}</span>
                </div>
              )}
              {item.pembina && (
                <div class="flex items-center gap-2 text-slate-500 text-[11px] truncate">
                  <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                  </svg>
                  <span class="truncate">Pembina: {item.pembina}</span>
                </div>
              )}
              <div class="pt-2 border-t border-slate-200/60 flex items-center justify-between">
                <span class="text-[11px] text-slate-500 font-mono truncate">{item.lokasi || 'Kampus Sekolah'}</span>
                <button
                  type="button"
                  onclick={`openEkskulModal(${JSON.stringify(item)})`}
                  class="inline-flex items-center gap-1 text-xs font-semibold text-cerulean-600 hover:text-cerulean-700 group/btn"
                >
                  <span>Detail &amp; Foto</span>
                  <span class="transition-transform group-hover/btn:translate-x-0.5">&rarr;</span>
                </button>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="no-ekskul-found" class="hidden text-center py-16">
      <div class="w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 mx-auto flex items-center justify-center mb-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
      </div>
      <h3 class="font-bold text-ocean-950 text-base">Tidak ada ekstrakurikuler pada kategori ini</h3>
      <p class="text-sm text-slate-500 mt-1">Pilih tab kategori lainnya untuk melihat daftar ekstrakurikuler.</p>
    </div>

    <!-- Bottom SPMB CTA Card -->
    <div class="mt-16 rounded-2xl bg-gradient-to-br from-ocean-950 via-ocean-900 to-ocean-950 text-white p-8 sm:p-10 border border-white/10 shadow-xl reveal">
      <div class="max-w-3xl">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-white/10 text-candiGold-400 font-mono text-xs font-semibold uppercase tracking-wider mb-4">
          {ctaBadge}
        </div>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          {ctaJudul}
        </h3>
        <p class="text-sky-100/90 text-sm sm:text-base mt-3 leading-relaxed">
          {ctaDeskripsi}
        </p>
        <div class="flex flex-wrap gap-4 mt-6">
          <a
            href="/spmb"
            class="px-5 py-2.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 font-bold text-sm shadow-md transition transform hover:-translate-y-0.5 active:scale-[0.98] inline-flex items-center gap-2"
          >
            <span>{spmb.aktif ? `Daftar SPMB ${spmb.tahun_ajaran}` : `Informasi SPMB ${spmb.tahun_ajaran}`}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/kontak"
            class="px-5 py-2.5 rounded-lg border border-white/30 hover:bg-white/10 text-white font-semibold text-sm backdrop-blur-sm transition inline-flex items-center gap-2"
          >
            <span>Konsultasi &amp; Kontak</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <EkskulModal />

  <script is:inline>
    const filterBtns = document.querySelectorAll('#ekskul-filter-tabs .filter-btn');
    const cards = document.querySelectorAll('.ekskul-card');
    const emptyState = document.getElementById('no-ekskul-found');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-ocean-950', 'text-white', 'active');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-ocean-950', 'text-white', 'active');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        const cat = btn.getAttribute('data-category');
        let visibleCount = 0;

        cards.forEach(card => {
          const itemCat = card.getAttribute('data-cat');
          if (cat === 'Semua' || itemCat === cat) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      });
    });
  </script>
</BaseLayout>
