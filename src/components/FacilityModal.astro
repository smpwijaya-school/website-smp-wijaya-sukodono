---
---

<div
  id="facility-modal"
  class="hidden fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div class="bg-white rounded-2xl max-w-3xl w-full overflow-hidden shadow-2xl relative transform scale-95 opacity-0 transition-all duration-200 ease-out max-h-[92vh] flex flex-col" id="modal-container">

    <!-- Visual Image Section -->
    <div id="modal-visual" class="aspect-[16/10] sm:aspect-[16/9] bg-gradient-to-br from-ocean-950 to-ocean-900 flex flex-col items-center justify-center p-6 text-center text-white relative overflow-hidden group shrink-0">
      <img id="modal-img" src="" alt="" class="hidden absolute inset-0 w-full h-full object-cover transition-opacity duration-200" />
      <div id="modal-overlay-bg" class="hidden absolute inset-0 bg-gradient-to-t from-ocean-950/95 via-ocean-950/20 to-black/30"></div>

      <!-- Prev / Next navigation buttons -->
      <button
        id="modal-prev-btn"
        type="button"
        class="hidden absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-ocean-950/80 hover:bg-ocean-950 text-white flex items-center justify-center backdrop-blur-sm transition shadow-lg border border-white/20 active:scale-95"
        aria-label="Foto Sebelumnya"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
      </button>
      <button
        id="modal-next-btn"
        type="button"
        class="hidden absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-ocean-950/80 hover:bg-ocean-950 text-white flex items-center justify-center backdrop-blur-sm transition shadow-lg border border-white/20 active:scale-95"
        aria-label="Foto Berikutnya"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </button>

      <!-- Badges & Counter Overlay -->
      <div class="absolute top-4 left-4 z-20 flex flex-wrap items-center gap-2">
        <span id="modal-category" class="px-3 py-1 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-xs font-bold shadow-md"></span>
      </div>

      <div class="absolute top-4 right-4 z-20">
        <span id="modal-photo-counter" class="hidden px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-white font-mono text-xs font-semibold border border-white/20"></span>
      </div>

      <div id="modal-title-overlay" class="absolute bottom-4 left-4 right-4 z-20 text-left text-xl sm:text-2xl font-extrabold text-white drop-shadow-md"></div>
    </div>

    <!-- Thumbnails Strip (Shown when multi-photo) -->
    <div id="modal-thumbnails" class="hidden px-4 py-2.5 flex items-center gap-2 overflow-x-auto border-b border-slate-200 bg-slate-100 shrink-0"></div>

    <!-- Modal Content Details -->
    <div class="p-6 overflow-y-auto space-y-4">
      <div>
        <h3 id="modal-title" class="text-xl font-bold text-ocean-950"></h3>
        <p id="modal-desc" class="text-sm text-slate-600 mt-2 leading-relaxed"></p>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="p-4 sm:px-6 bg-slate-50 border-t border-slate-200 flex items-center justify-between gap-3 shrink-0">
      <a
        href="/spmb"
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-cerulean-600 hover:text-cerulean-700 transition"
      >
        <span>Tertarik bergabung? Info SPMB &rarr;</span>
      </a>
      <button
        id="close-modal-btn"
        type="button"
        class="px-5 py-2 rounded-lg bg-ocean-950 text-white text-sm font-semibold hover:bg-ocean-900 transition active:scale-95 shadow-sm focus:outline-none focus:ring-2 focus:ring-cerulean-600"
      >
        Tutup
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function initFacilityModal() {
    const modal = document.getElementById('facility-modal');
    const closeBtn = document.getElementById('close-modal-btn');
    const container = document.getElementById('modal-container');
    const prevBtn = document.getElementById('modal-prev-btn');
    const nextBtn = document.getElementById('modal-next-btn');
    const counter = document.getElementById('modal-photo-counter');
    const thumbsContainer = document.getElementById('modal-thumbnails');
    const modalImg = document.getElementById('modal-img');
    const modalOverlay = document.getElementById('modal-overlay-bg');

    let currentPhotos = [];
    let currentPhotoIndex = 0;
    let lastFocusedElement = null;

    function updateModalPhoto(index) {
      if (!currentPhotos.length) return;
      currentPhotoIndex = (index + currentPhotos.length) % currentPhotos.length;
      modalImg.src = currentPhotos[currentPhotoIndex];
      modalImg.classList.remove('hidden');
      if (modalOverlay) modalOverlay.classList.remove('hidden');

      if (currentPhotos.length > 1) {
        if (counter) {
          counter.textContent = `Foto ${currentPhotoIndex + 1} dari ${currentPhotos.length}`;
          counter.classList.remove('hidden');
        }
        if (thumbsContainer) {
          thumbsContainer.querySelectorAll('button').forEach((btn, i) => {
            if (i === currentPhotoIndex) {
              btn.classList.add('ring-2', 'ring-cerulean-600', 'opacity-100');
              btn.classList.remove('opacity-60');
            } else {
              btn.classList.remove('ring-2', 'ring-cerulean-600', 'opacity-100');
              btn.classList.add('opacity-60');
            }
          });
        }
      }
    }

    window.openFacilityModal = function(item) {
      if (!modal) return;
      lastFocusedElement = document.activeElement;

      document.getElementById('modal-category').textContent = item.kategori || '';
      document.getElementById('modal-title-overlay').textContent = item.nama || '';
      document.getElementById('modal-title').textContent = item.nama || '';
      document.getElementById('modal-desc').textContent = item.deskripsi || '';

      const gallery = Array.isArray(item.galeri) ? item.galeri : [];
      currentPhotos = [item.foto, ...gallery].filter(Boolean);
      currentPhotoIndex = 0;

      if (currentPhotos.length > 0) {
        modalImg.alt = item.nama || 'Foto Fasilitas';
        updateModalPhoto(0);

        if (currentPhotos.length > 1) {
          prevBtn?.classList.remove('hidden');
          nextBtn?.classList.remove('hidden');
          if (thumbsContainer) {
            thumbsContainer.innerHTML = currentPhotos.map((src, i) => `
              <button type="button" onclick="window._setFacilityModalPhoto(${i})" class="w-16 h-11 rounded-lg overflow-hidden border border-slate-300 shrink-0 transition ${i === 0 ? 'ring-2 ring-cerulean-600 opacity-100' : 'opacity-60 hover:opacity-100'}" aria-label="Pilih foto ${i + 1}">
                <img src="${src}" alt="" class="w-full h-full object-cover" />
              </button>
            `).join('');
            thumbsContainer.classList.remove('hidden');
          }
        } else {
          prevBtn?.classList.add('hidden');
          nextBtn?.classList.add('hidden');
          counter?.classList.add('hidden');
          thumbsContainer?.classList.add('hidden');
        }
      } else {
        modalImg.src = '';
        modalImg.classList.add('hidden');
        modalOverlay?.classList.add('hidden');
        prevBtn?.classList.add('hidden');
        nextBtn?.classList.add('hidden');
        counter?.classList.add('hidden');
        thumbsContainer?.classList.add('hidden');
      }

      document.body.classList.add('overflow-hidden');
      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        container?.classList.remove('scale-95', 'opacity-0');
        closeBtn?.focus();
      });
    };

    window._setFacilityModalPhoto = function(idx) {
      updateModalPhoto(idx);
    };

    prevBtn?.addEventListener('click', () => updateModalPhoto(currentPhotoIndex - 1));
    nextBtn?.addEventListener('click', () => updateModalPhoto(currentPhotoIndex + 1));

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0');
      container?.classList.add('scale-95', 'opacity-0');
      document.body.classList.remove('overflow-hidden');
      setTimeout(() => {
        modal.classList.add('hidden');
        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
          lastFocusedElement.focus();
        }
      }, 200);
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (!container.contains(e.target)) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (modal && !modal.classList.contains('hidden')) {
        if (e.key === 'Escape') {
          closeModal();
        } else if (e.key === 'ArrowLeft' && currentPhotos.length > 1) {
          updateModalPhoto(currentPhotoIndex - 1);
        } else if (e.key === 'ArrowRight' && currentPhotos.length > 1) {
          updateModalPhoto(currentPhotoIndex + 1);
        } else if (e.key === 'Tab') {
          const focusable = container.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.open-facility-modal-btn');
      if (trigger && trigger.dataset.facility) {
        try {
          const item = JSON.parse(trigger.dataset.facility);
          window.openFacilityModal(item);
        } catch (err) {
          console.error('Failed to parse facility data', err);
        }
      }
    });
  })();
</script>
