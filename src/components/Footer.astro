---
import { pengaturan, spmb } from '../utils/data';

const cleanWa = (pengaturan.kontak.whatsapp || '').replace(/\D/g, '').replace(/^0/, '62');
const currentYear = new Date().getFullYear();
---

<footer class="bg-ocean-950 text-slate-300 border-t border-white/10 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid md:grid-cols-12 gap-10">
      <!-- Col 1: Identitas Sekolah -->
      <div class="md:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-white/10 p-1 shrink-0">
            <svg viewBox="0 0 200 200" class="w-full h-full"><use href="#logo-smp-wijaya"></use></svg>
          </div>
          <div>
            <div class="text-white font-extrabold text-lg leading-tight">{pengaturan.nama_sekolah.toUpperCase()}</div>
            <div class="text-[11px] font-mono text-wijayaCyan-400">NPSN: {pengaturan.npsn} &bull; {pengaturan.akreditasi.toUpperCase()}</div>
          </div>
        </div>
        <p class="text-sm text-slate-300/90 leading-relaxed">
          {pengaturan.hero?.deskripsi || 'Lembaga pendidikan menengah pertama di Desa Pekarungan, Sukodono, Sidoarjo yang berkomitmen mencetak generasi berkarakter, berilmu, dan berprestasi.'}
        </p>
      </div>

      <!-- Col 2: Navigasi Profil -->
      <div class="md:col-span-2 space-y-3">
        <div class="text-white font-bold text-sm uppercase tracking-wider">Profil</div>
        <ul class="space-y-2 text-sm">
          <li><a href="/profil" class="hover:text-candiGold-400 transition">Tentang Kami</a></li>
          <li><a href="/profil#visi-misi" class="hover:text-candiGold-400 transition">Visi &amp; Misi</a></li>
          <li><a href="/profil#filosofi" class="hover:text-candiGold-400 transition">Filosofi Logo</a></li>
          <li><a href="/guru" class="hover:text-candiGold-400 transition">Guru &amp; Staf</a></li>
        </ul>
      </div>

      <!-- Col 3: Navigasi Informasi -->
      <div class="md:col-span-3 space-y-3">
        <div class="text-white font-bold text-sm uppercase tracking-wider">Informasi</div>
        <ul class="space-y-2 text-sm">
          <li><a href="/berita" class="hover:text-candiGold-400 transition">Berita &amp; Prestasi</a></li>
          <li><a href="/fasilitas" class="hover:text-candiGold-400 transition">Fasilitas Sekolah</a></li>
          <li><a href="/ekstrakurikuler" class="hover:text-candiGold-400 transition">Ekstrakurikuler</a></li>
          <li><a href="/spmb" class="hover:text-candiGold-400 transition">{spmb.aktif ? 'Daftar SPMB' : 'Info SPMB'}</a></li>
          <li><a href="/kontak" class="hover:text-candiGold-400 transition">Hubungi Kami</a></li>
        </ul>
      </div>

      <!-- Col 4: Kontak Resmi -->
      <div class="md:col-span-3 space-y-3">
        <div class="text-white font-bold text-sm uppercase tracking-wider">Kontak Resmi</div>
        <ul class="space-y-2 text-sm text-slate-300">
          <li class="leading-relaxed">{pengaturan.kontak.alamat}</li>
          <li class="font-mono">Telp: {pengaturan.kontak.telepon}</li>
          {cleanWa && (
            <li class="font-mono">
              <a
                href={`https://wa.me/${cleanWa}?text=Halo%20Tata%20Usaha%20${encodeURIComponent(pengaturan.nama_sekolah)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-candiGold-400 transition inline-flex items-center gap-1.5"
              >
                <span>WA: +{cleanWa}</span>
              </a>
            </li>
          )}
          <li class="font-mono text-xs text-sky-200">
            <a href={`mailto:${pengaturan.kontak.email}`} class="hover:text-candiGold-400 transition">
              {pengaturan.kontak.email}
            </a>
          </li>
          {pengaturan.kontak.instagram && (
            <li class="pt-1">
              <a
                href={pengaturan.kontak.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-candiGold-400 hover:text-yellow-300 underline underline-offset-4 transition inline-flex items-center gap-1"
              >
                <span>Instagram Resmi Sekolah</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-slate-400">
      <div>&copy; {currentYear} {pengaturan.nama_sekolah}. Hak Cipta Dilindungi.</div>
      <div>
        Dikembangkan oleh <a href="https://rohmadaditya.my.id" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-candiGold-400 transition underline underline-offset-4 font-medium">Rohmad Aditya</a>
      </div>
    </div>
  </div>
</footer>
