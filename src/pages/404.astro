---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pengaturan } from '../utils/data';

const quickLinks = [
  { label: 'Beranda Utama', desc: 'Halaman depan & informasi umum sekolah', href: '/' },
  { label: 'Tentang & Profil', desc: 'Sejarah, visi misi, & filosofi lambang', href: '/profil' },
  { label: 'Katalog Fasilitas', desc: 'Sarana belajar, lab komputer, & musholla', href: '/fasilitas' },
  { label: 'Ekstrakurikuler', desc: 'Drumband, voli, pramuka, paskibra, & seni', href: '/ekstrakurikuler' },
  { label: 'Direktori Guru', desc: 'Daftar pendidik & staf Tata Usaha', href: '/guru' },
  { label: 'Informasi SPMB', desc: 'Alur pendaftaran murid baru & beasiswa', href: '/spmb' },
  { label: 'Berita & Prestasi', desc: 'Dokumentasi kegiatan siswa terbaru', href: '/berita' },
  { label: 'Hubungi Sekolah', desc: 'Alamat, telepon kantor, & lokasi maps', href: '/kontak' },
];
---

<BaseLayout
  title={`Halaman Tidak Ditemukan (404) — ${pengaturan.nama_sekolah}`}
  description={`Halaman yang Anda tuju tidak ditemukan atau telah dipindahkan di website resmi ${pengaturan.nama_sekolah}.`}
  activeNav="404"
>
  <div class="min-h-[75vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-2xl w-full text-center space-y-8">
      
      <!-- 404 Graphic Badge -->
      <div class="relative inline-flex items-center justify-center">
        <div class="w-32 h-32 rounded-3xl bg-ocean-950 text-candiGold-400 flex items-center justify-center shadow-xl border-4 border-candiGold-400/30">
          <span class="text-5xl font-black font-mono tracking-tighter">404</span>
        </div>
      </div>

      <div class="space-y-3">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-bold bg-amber-100 text-amber-900 uppercase tracking-wider">
          Halaman Tidak Ditemukan
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-ocean-950 tracking-tight">
          Alamat yang Anda Tuju Tidak Tersedia
        </h1>
        <p class="text-sm sm:text-base text-slate-600 max-w-lg mx-auto leading-relaxed">
          Tautan yang Anda buka mungkin telah berpindah ke alamat baru, dihapus, atau terjadi kesalahan pengetikan alamat URL.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-cerulean-600 hover:bg-cerulean-700 text-white text-sm font-semibold transition shadow-sm active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
          <span>Kembali ke Beranda</span>
        </a>
        <a
          href="/kontak"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-white hover:bg-slate-100 text-ocean-950 border border-slate-300 text-sm font-semibold transition active:scale-95"
        >
          <span>Hubungi Tata Usaha</span>
        </a>
      </div>

      <!-- Quick Navigation Grid -->
      <div class="pt-8 border-t border-slate-200 text-left">
        <div class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 mb-4 text-center">
          Atau jelajahi menu penting berikut:
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          {quickLinks.map(item => (
            <a
              href={item.href}
              class="p-4 rounded-xl bg-white border border-slate-200 hover:border-cerulean-600/50 hover:shadow-sm transition flex flex-col group"
            >
              <div class="font-bold text-ocean-950 text-sm group-hover:text-cerulean-600 transition flex items-center justify-between">
                <span>{item.label}</span>
                <span class="text-slate-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
              <p class="text-xs text-slate-500 mt-1">{item.desc}</p>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
