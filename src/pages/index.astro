---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pengaturan, guruData, fasilitasData, spmb } from '../utils/data';
import FacilityModal from '../components/FacilityModal.astro';
import type { GuruItem } from '../content.config';

const allBerita = await getCollection('berita', ({ data }) => !data.draft);
const sortedBerita = allBerita
  .sort((a, b) => b.data.tanggal.getTime() - a.data.tanggal.getTime())
  .slice(0, 3);

const featuredFacilities = (fasilitasData.daftar || []).slice(0, 6);
const pimpinanList = ((guruData.daftar || []) as GuruItem[]).filter(
  (g) => g.bidang?.toLowerCase() === 'pimpinan'
);

function formatDate(date: Date) {
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
}

const hero = pengaturan.hero || {};
const heroFoto = hero.foto?.trim() || '/images/hero/hero-home.webp';
const heroDeskripsi = hero.deskripsi?.trim() || 'Enam dekade mengabdi mencetak insan berakhlak mulia, unggul akademik, dan berprestasi di Pekarungan, Sukodono.';
const heroTombolUtamaTeks = hero.tombol_utama_teks?.trim() || (spmb.aktif ? `Informasi SPMB ${spmb.tahun_ajaran}` : `Informasi SPMB`);
const heroTombolUtamaLink = hero.tombol_utama_link?.trim() || '/spmb';
const heroTombolSekunderTeks = hero.tombol_sekunder_teks?.trim() || 'Profil Sekolah';
const heroTombolSekunderLink = hero.tombol_sekunder_link?.trim() || '/profil';

const defaultPrograms = [
  { nomor: "01", judul: "Kurikulum Merdeka & P5", deskripsi: "Pembelajaran kontekstual berpusat pada siswa serta Proyek Penguatan Profil Pelajar Pancasila yang melatih kolaborasi." },
  { nomor: "02", judul: "Drumband & Seni Budaya", deskripsi: "Unit Marching Band aktif berprestasi di tingkat Kabupaten Sidoarjo, melatih disiplin, kekompakan, dan percaya diri." },
  { nomor: "03", judul: "Pembinaan Olahraga", deskripsi: "Klub bola voli dan olahraga prestasi yang aktif menyelenggarakan turnamen antar-SD se-Kecamatan Sukodono." },
  { nomor: "04", judul: "Karakter & Kepemimpinan", deskripsi: "Pembiasaan ibadah harian, literasi pagi, OSIS, Pramuka, dan Paskibra untuk membentuk pribadi tangguh dan santun." }
];
const programs = (pengaturan.program_unggulan && pengaturan.program_unggulan.length > 0)
  ? pengaturan.program_unggulan
  : defaultPrograms;
---

<BaseLayout
  title="SMP Wijaya Sukodono — Website Resmi Sekolah (NPSN: 20540036)"
  description="Website resmi SMP Wijaya Sukodono, Desa Pekarungan, Kec. Sukodono, Kab. Sidoarjo, Jawa Timur. Informasi profil sekolah, fasilitas, direktori guru, berita prestasi, dan SPMB 2026/2027."
  activeNav="home"
>
  <!-- Hero Section -->
  <div class="relative bg-ocean-950 text-white overflow-hidden">
    <!-- Background Image with Gradient Overlay -->
    <img
      src={heroFoto}
      alt={`${pengaturan.nama_sekolah} - Kampus dan Lingkungan Sekolah`}
      class="absolute inset-0 w-full h-full object-cover object-center animate-hero-bg"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ocean-950/85 via-ocean-950/80 to-ocean-950/95"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32 text-center">
      {hero.judul_sorot ? (
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.16] text-white animate-hero-title">
          {hero.judul || 'Membangun Generasi'}{' '}
          <span class="text-candiGold-400">{hero.judul_sorot}</span>
          {hero.judul_akhiran ? ` ${hero.judul_akhiran}` : ''}
        </h1>
      ) : hero.judul && hero.judul.includes('<') ? (
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.16] text-white animate-hero-title" set:html={hero.judul} />
      ) : (
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.16] text-white animate-hero-title">
          {hero.judul ? (
            hero.judul
          ) : (
            <>
              Membangun Generasi <span class="text-candiGold-400">Berilmu, Berkarakter,</span> &amp; Berprestasi
            </>
          )}
        </h1>
      )}

      <p class="text-base sm:text-lg text-sky-100/90 leading-relaxed max-w-xl mx-auto mt-5 animate-hero-desc">
        {heroDeskripsi}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3.5 pt-8 animate-hero-cta">
        {heroTombolUtamaTeks && (
          <a
            href={heroTombolUtamaLink}
            class="px-6 py-3 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 font-bold text-sm sm:text-base shadow-lg transition transform hover:-translate-y-0.5 active:scale-[0.98] inline-block"
          >
            {heroTombolUtamaTeks}
          </a>
        )}
        {heroTombolSekunderTeks && (
          <a
            href={heroTombolSekunderLink}
            class="px-6 py-3 rounded-lg border border-white/30 hover:bg-white/10 text-white font-semibold text-sm sm:text-base backdrop-blur-sm transition transform hover:-translate-y-0.5 active:scale-[0.98] inline-block"
          >
            {heroTombolSekunderTeks}
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Sambutan Kepala Sekolah -->
  <div class="bg-white py-16 lg:py-24 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-4 reveal">
          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm card-interactive">
            <div class={`aspect-[4/5] bg-gradient-to-br from-ocean-950 to-ocean-900 flex flex-col items-center justify-center text-center relative overflow-hidden group ${pengaturan.sambutan_kepsek.foto ? '' : 'p-6'}`}>
              {pengaturan.sambutan_kepsek.foto ? (
                <img src={pengaturan.sambutan_kepsek.foto} alt={pengaturan.sambutan_kepsek.nama} class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105" />
              ) : (
                <>
                  <div class="w-28 h-28 rounded-full bg-wijayaCyan-50 border-4 border-candiGold-400 flex items-center justify-center text-ocean-950 text-3xl font-extrabold mb-4 shadow-lg transition duration-300 group-hover:scale-105">YF</div>
                  <div class="text-white font-bold text-lg">{pengaturan.sambutan_kepsek.nama}</div>
                  <div class="text-xs font-mono text-wijayaCyan-400 uppercase tracking-wider mt-1">Kepala SMP Wijaya Sukodono</div>
                </>
              )}
            </div>
          </div>
        </div>
        <div class="lg:col-span-8 space-y-5 reveal delay-150">
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Sambutan Kepala Sekolah</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 tracking-tight">
            {pengaturan.sambutan_kepsek.judul || 'Bersama Menyiapkan Generasi Unggul yang Siap Melangkah Lebih Jauh'}
          </h2>
          {pengaturan.sambutan_kepsek.pesan ? (
            pengaturan.sambutan_kepsek.pesan.split('\n\n').map((p) => (
              <p class="text-slate-600 leading-relaxed">{p}</p>
            ))
          ) : (
            <p class="text-slate-600 leading-relaxed">
              Assalamu'alaikum warahmatullahi wabarakatuh. Puji syukur ke hadirat Allah SWT atas terselenggaranya laman informasi resmi SMP Wijaya Sukodono. Kehadiran website ini menjadi wujud komitmen kami dalam menghadirkan keterbukaan informasi, mendokumentasikan capaian prestasi siswa, serta memudahkan komunikasi antara sekolah, orang tua, alumni, dan masyarakat Sukodono.
            </p>
          )}
          <div class="pt-2 flex flex-wrap items-center gap-6">
            <div>
              <div class="font-bold text-ocean-950">{pengaturan.sambutan_kepsek.nama}</div>
              <div class="text-xs text-slate-500">Kepala Sekolah &bull; {pengaturan.nama_sekolah}</div>
            </div>
            <a href="/profil" class="inline-flex items-center gap-1.5 text-sm font-semibold text-cerulean-600 hover:text-cerulean-700 transition group">
              <span>Baca Profil Lengkap</span>
              <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4 Program Unggulan -->
  <div class="bg-slate-50 py-16 lg:py-24 border-b border-slate-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 reveal">
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Pilar Pendidikan</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 mt-1">Program Unggulan Sekolah</h2>
        </div>
        <div class="flex flex-col sm:items-end gap-1">
          <a href="/ekstrakurikuler" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-cerulean-600 hover:text-cerulean-700 transition group mt-1">
            <span>Lihat Direktori Ekstrakurikuler</span>
            <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {programs.map((prog, idx) => (
          <div class={`bg-white rounded-xl border border-slate-200 p-6 card-interactive reveal delay-${(idx + 1) * 75}`}>
            <div class="w-11 h-11 rounded-lg bg-wijayaCyan-50 text-cerulean-600 flex items-center justify-center mb-4 font-bold font-mono">
              {prog.nomor}
            </div>
            <h3 class="text-lg font-bold text-ocean-950 mb-2">{prog.judul}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{prog.deskripsi}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Pimpinan Sekolah -->
  {pimpinanList.length > 0 && (
    <div class="bg-white py-16 lg:py-24 border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 reveal">
          <div>
            <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Pimpinan Sekolah</div>
            <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 mt-1">Pimpinan &amp; Manajemen</h2>
          </div>
          <a href="/guru" class="inline-flex items-center gap-1.5 text-sm font-semibold text-cerulean-600 hover:text-cerulean-700 transition group">
            <span>Lihat Seluruh Guru &amp; Staf</span>
            <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {pimpinanList.map((g, idx) => {
            const foto = g.foto || (g.nama === pengaturan.sambutan_kepsek?.nama ? pengaturan.sambutan_kepsek?.foto : undefined);
            return (
              <div
                class={`bg-white rounded-xl border border-cerulean-600/30 ring-1 ring-cerulean-600/10 overflow-hidden card-interactive transition flex flex-col group reveal delay-${(idx + 1) * 100}`}
              >
                <div class={`aspect-[4/5] w-full overflow-hidden relative ${foto ? 'bg-slate-100' : 'bg-ocean-950 text-candiGold-400'} flex items-center justify-center`}>
                  {foto ? (
                    <>
                      <img
                        src={foto}
                        alt={g.nama}
                        class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105"
                        loading="lazy"
                        onerror="this.style.display='none';this.nextElementSibling?.classList.remove('hidden');"
                      />
                      <span class="hidden text-4xl font-extrabold tracking-tight text-candiGold-400">
                        {g.inisial || g.nama.slice(0, 2).toUpperCase()}
                      </span>
                    </>
                  ) : (
                    <span class="text-4xl font-extrabold tracking-tight">
                      {g.inisial || g.nama.slice(0, 2).toUpperCase()}
                    </span>
                  )}
                </div>
                <div class="p-5 sm:p-6 text-center flex-1 flex flex-col items-center justify-center">
                  <span class="inline-block px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 font-mono text-[11px] font-semibold mb-2">
                    {g.bidang}
                  </span>
                  <h3 class="font-bold text-ocean-950 text-base sm:text-lg group-hover:text-cerulean-600 transition">
                    {g.nama}
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-600 mt-1 font-medium">{g.jabatan}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  )}

  <!-- Pratinjau Fasilitas -->
  <div class="bg-white py-16 lg:py-24 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 reveal">
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Sarana Prasarana</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 mt-1">Fasilitas Pendukung Belajar</h2>
        </div>
        <a href="/fasilitas" class="inline-flex items-center gap-1.5 text-sm font-semibold text-cerulean-600 hover:text-cerulean-700 transition group">
          <span>Lihat Semua Fasilitas</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredFacilities.map((item, idx) => {
          const totalPhotos = (item.foto ? 1 : 0) + (Array.isArray(item.galeri) ? item.galeri.length : 0);
          return (
            <div class={`bg-white rounded-xl border border-slate-200 overflow-hidden card-interactive transition flex flex-col reveal delay-${(idx % 3 + 1) * 75} group`}>
              <div class="aspect-[16/10] bg-gradient-to-br from-ocean-950 to-ocean-900 relative overflow-hidden">
                {item.foto ? (
                  <>
                    <img src={item.foto} alt={item.nama} class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" onerror="this.style.display='none';" />
                    <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-ocean-950/20 to-black/30"></div>
                  </>
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-white/40">
                    <svg class="w-16 h-16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                    </svg>
                  </div>
                )}
                <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2 z-10">
                  <span class="px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white font-mono text-[11px] font-semibold">{item.kategori}</span>
                </div>
                <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between gap-2 z-10">
                  <span class="text-white font-bold text-sm sm:text-base leading-tight drop-shadow truncate pr-2">{item.nama}</span>
                  <button
                    type="button"
                    data-facility={JSON.stringify(item)}
                    class="open-facility-modal-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 text-xs font-bold transition-all duration-200 active:scale-95 shrink-0 shadow-md"
                    aria-label={`Lihat foto ${item.nama}`}
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                    </svg>
                    <span>{totalPhotos > 1 ? `${totalPhotos} Foto` : 'Lihat Foto'}</span>
                  </button>
                </div>
              </div>
              <div class="p-5 flex-1">
                <h3 class="font-bold text-ocean-950 text-base">{item.nama}</h3>
                <p class="text-sm text-slate-600 mt-1.5 leading-relaxed">{item.deskripsi}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Berita Terbaru (3 Artikel) -->
  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 reveal">
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Kabar Sekolah</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 mt-1">Berita &amp; Prestasi Terbaru</h2>
        </div>
        <a href="/berita" class="inline-flex items-center gap-1.5 text-sm font-semibold text-cerulean-600 hover:text-cerulean-700 transition group">
          <span>Lihat Semua Berita</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {sortedBerita.map((item, idx) => (
          <a href={`/berita/${item.id}`} class={`bg-white rounded-xl border border-slate-200 overflow-hidden card-interactive transition flex flex-col group reveal delay-${(idx + 1) * 100}`}>
            <div class="aspect-video bg-gradient-to-br from-ocean-950 to-ocean-900 p-5 flex flex-col justify-between relative overflow-hidden">
              {item.data.thumbnail ? (
                <img src={item.data.thumbnail} alt={item.data.title} class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105" />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center opacity-30">
                  <svg viewBox="0 0 200 200" class="w-16 h-16 transition-transform duration-500 group-hover:scale-110"><use href="#logo-smp-wijaya"></use></svg>
                </div>
              )}
              <span class="relative z-10 self-start px-2.5 py-1 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-[11px] font-bold shadow-sm">{item.data.kategori}</span>
              <span class="relative z-10 text-sky-200 font-mono text-xs">{formatDate(item.data.tanggal)}</span>
            </div>
            <div class="p-5 flex-1 flex flex-col">
              <h3 class="font-bold text-ocean-950 text-base leading-snug line-clamp-2 group-hover:text-cerulean-600 transition">
                {item.data.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                {item.data.ringkasan}
              </p>
              <div class="pt-4 text-xs font-semibold text-cerulean-600 mt-auto flex items-center gap-1">
                <span>Baca Selengkapnya</span>
                <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA Strip SPMB -->
  <div class="bg-ocean-950 text-white py-14 border-t-4 border-candiGold-400 reveal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="text-xs font-mono uppercase tracking-widest text-candiGold-400 font-semibold">SPMB Tahun Ajaran {spmb.tahun_ajaran}</div>
        <h2 class="text-2xl sm:text-3xl font-bold">Bergabunglah Bersama Keluarga Besar {pengaturan.nama_sekolah}</h2>
        <p class="text-sm sm:text-base text-sky-100/90">
          {spmb.aktif
            ? 'Kunjungi halaman informasi SPMB untuk melihat syarat berkas, jadwal gelombang, atau hubungi langsung panitia Tata Usaha kami.'
            : 'Pendaftaran saat ini sedang ditutup. Anda dapat melihat informasi gelombang, persyaratan berkas, atau menghubungi langsung kantor Tata Usaha kami.'}
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/spmb"
          class="px-6 py-3.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 font-bold text-sm transition transform hover:-translate-y-0.5 active:scale-[0.98] inline-block shadow-md"
        >
          {spmb.aktif ? 'Buka Info SPMB' : 'Lihat Info SPMB'}
        </a>
        <a
          href="/kontak"
          class="px-6 py-3.5 rounded-lg border border-white/30 hover:bg-white/10 text-white font-semibold text-sm transition transform hover:-translate-y-0.5 active:scale-[0.98] inline-block"
        >
          Hubungi Tata Usaha
        </a>
      </div>
